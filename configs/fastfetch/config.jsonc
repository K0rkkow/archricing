{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "file", "source": "~/.local/share/archricing/logo-ascii.txt", "color": { "1": "magenta", "2": "cyan" } },
  "display": { "separator": "  ", "color": "magenta", "brightColor": true },
  "modules": [
    { "type": "title", "format": "{user-name}@{host-name} — ArchRicing" },
    "separator",
    { "type": "os", "key": "OS" },
    { "type": "kernel", "key": "Kernel" },
    { "type": "desktop", "key": "Desktop" },
    { "type": "shell", "key": "Shell" },
    { "type": "terminal", "key": "Terminal" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "Memory" },
    { "type": "resolution", "key": "Resolution" },
    { "type": "uptime", "key": "Uptime" },
    "break", "colors"
  ]
}
