# Préserve les fins de ligne LF (les scripts bash cassent avec CRLF) et le UTF-8.
*.sh text eol=lf
*.py text eol=lf
*.conf text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.desktop text eol=lf
*.svg text eol=lf
*.zshrc text eol=lf
kwinrc text eol=lf
profiledef.sh text eol=lf
